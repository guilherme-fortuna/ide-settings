        "list.inactiveSelectionForeground": "#00ffff",
        "list.hoverBackground": "#001a1a",
        "list.hoverForeground": "#00ffff",
        "list.focusBackground": "#005555",
        "list.highlightForeground": "#00ffff",
        // ── Scrollbar ─────────────────────────────────
        "scrollbarSlider.background": "#005555aa",
