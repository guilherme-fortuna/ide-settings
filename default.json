        "badge.background": "#00ffff",
        "badge.foreground": "#000000",
        "notificationCenter.border": "#005555",
        "notifications.background": "#000000",
        "notifications.foreground": "#00ffff",
        // ── Menu ──────────────────────────────────────
        "menu.background": "#000000",
        "menu.foreground": "#00ffff",
        "menu.selectionBackground": "#005555",
        "menu.selectionForeground": "#00ffff",
        "menu.border": "#005555",
        "menubar.selectionBackground": "#001a1a",
        "menubar.selectionForeground": "#00ffff",
        // ── Minimap ───────────────────────────────────
        "minimap.background": "#000000",
        "minimapSlider.background": "#005555aa",
        "minimapSlider.hoverBackground": "#00ffffaa",
        // ── Breadcrumb ────────────────────────────────
        "breadcrumb.background": "#000000",
        "breadcrumb.foreground": "#005555",
        "breadcrumb.activeSelectionForeground": "#00ffff",
        "breadcrumbPicker.background": "#000000",
        // ── Quick Pick / Command Palette ──────────────
        "quickInput.background": "#000000",
        "quickInput.foreground": "#00ffff",
        "quickInputTitle.background": "#000000",
        "quickInputList.focusBackground": "#005555"
