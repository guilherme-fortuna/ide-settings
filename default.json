{
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Git Bash": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "editor.largeFileOptimizations": false,
    "files.autoSave": "onWindowChange",
    "git.autofetch": true,
    "editor.overviewRulerBorder": false,
    "outline.problems.badges": false,
    "python.languageServer": "Default",
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.iconTheme": "vscode-icons",
    "editor.lineHeight": 36,
    "editor.fontSize": 16,
    "workbench.activityBar.location": "top",
    "editor.stickyScroll.enabled": false,
    "workbench.colorTheme": "Best Themes - Brogrammer",
    "window.newWindowProfile": "Default",
    "workbench.colorCustomizations": {
        // ── Activity Bar ──────────────────────────────
        "activityBar.background": "#000000",
        "activityBar.foreground": "#00ffff",
        "activityBar.inactiveForeground": "#005555",
        "activityBar.activeBackground": "#000000",
        "activityBarBadge.background": "#00ffff",
        "activityBarBadge.foreground": "#000000",
        // ── Title & Status Bar ────────────────────────
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#00ffff",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#005555",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#00ffff",
        "statusBar.noFolderBackground": "#000000",
        "statusBar.debuggingBackground": "#000000",
        "statusBarItem.hoverBackground": "#001a1a",
        "statusBarItem.remoteBackground": "#000000",
        "statusBarItem.remoteForeground": "#00ffff",
        "commandCenter.border": "#00ffff",
        "sash.hoverBorder": "#00ffff",
        // ── Sidebar ───────────────────────────────────
        "sideBar.background": "#000000",
        "sideBar.foreground": "#00ffff",
        "sideBar.border": "#001a1a",
        "sideBarTitle.foreground": "#00ffff",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.foreground": "#00ffff",
        "sideBarSectionHeader.border": "#001a1a",
        // ── Editor ────────────────────────────────────
        "editor.background": "#000",
        "editor.foreground": "#00ffff",
        "editorLineNumber.foreground": "#003333",
        "editorLineNumber.activeForeground": "#00ffff",
        "editor.lineHighlightBackground": "#001a1a",
        "editor.selectionBackground": "#005555",
        "editor.inactiveSelectionBackground": "#003333",
        "editor.findMatchBackground": "#005555",
        "editor.findMatchHighlightBackground": "#003333",
        "editorCursor.foreground": "#00ffff",
